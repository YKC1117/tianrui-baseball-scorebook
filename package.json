{
  "name": "tianrui-baseball-scorebook",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:db": "node tests/database.mjs",
    "test:browser": "playwright test",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test:local": "node tests/local-integration.mjs",
    "preflight": "node scripts/firebase-preflight.mjs",
    "privacy:inventory": "node scripts/privacy-inventory.mjs",
    "build:firebase": "node scripts/build-firebase.mjs",
    "test:firebase": "firebase emulators:exec --project demo-tianrui --only auth,firestore \"node --import ./tests/support/firebase-node.mjs --test tests/firebase/*.test.mjs\"",
    "test:firebase:browser": "firebase emulators:exec --project demo-tianrui --only auth,firestore \"node --import ./tests/support/firebase-node.mjs node_modules/@playwright/test/cli.js test --config playwright.firebase.config.mjs\"",
    "preflight:supabase": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.35.0"
  },
  "dependencies": {
    "firebase": "13.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
